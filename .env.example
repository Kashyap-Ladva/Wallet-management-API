DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wallet_management
REDIS_URL=redis://localhost:6379/0

# Celery Broker and Result Backend (Logical Redis DB Isolation)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_CONCURRENCY=4

# Flower Monitoring Dashboard (Optional)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin123!

SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
FILE_STORAGE_PATH=app/data/proofs

# Redis Caching TTLs (in seconds)
ANALYTICS_DAILY_CACHE_TTL=60
ANALYTICS_MONTHLY_CACHE_TTL=300
ANALYTICS_DEFAULT_CACHE_TTL=120

# Distributed Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_READ=120/minute
RATE_LIMIT_WRITE=30/minute
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_PROXIES=
