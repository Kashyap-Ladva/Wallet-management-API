                <mxCell id="rel_mini_transaction" edge="1" parent="1" source="mini_wallets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;" target="transactions" value="1 : many">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rel_wallet_transaction" edge="1" parent="1" source="wallets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;dashed=1;" target="transactions" value="1 : many (also composite FK validates ownership)">
                    <mxGeometry relative="1" as="geometry"/>
